{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "esModuleInterop": true,

    "baseUrl": "./",

    "types": ["node", "jest"],

    "paths": {
      "@backend-foundation/common": ["libs/common/src"],
      "@backend-foundation/common/*": ["libs/common/src/*"],
      "@backend-foundation/authorization": ["libs/authorization/src"],
      "@backend-foundation/authorization/*": ["libs/authorization/src/*"],

      "@config/*": ["src/config/*"],
      "@config": ["src/config"],

      "@modules/*": ["src/modules/*"],
      "@modules/auth/*": ["src/modules/auth/*"],
      "@modules/user/*": ["src/modules/user/*"],
      "@modules/housing/*": ["src/modules/housing/*"],
      "@modules/job/*": ["src/modules/job/*"],
      "@modules/community/*": ["src/modules/community/*"],

      "@infra/*": ["src/infrastructure/*"]
    },

    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  }
}
