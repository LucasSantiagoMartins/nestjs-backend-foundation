# Application
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost # postgres in prod 
DB_PORT=5432
DB_USER=postgres
DB_PASS=change_me
DB_NAME=backend_foundation

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback

# Cloudflare R2
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_URL=
R2_BUCKET=
R2_ENDPOINT=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Redis
REDIS_HOST=localhost # redis in prod 
REDIS_PORT=6379

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=

# Better Stack Logging
BETTER_STACK_INGEST_URL=
BETTER_STACK_TOKEN=

# Resend Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Payments

# Mock Payment Processing (development/testing only)
PAYMENT_MOCK_OUTCOMES=success,failure

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
